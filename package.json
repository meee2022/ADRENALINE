{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5001",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "build:ios": "tsx script/verify-ios-release.ts && vite build --mode ios && npx cap sync ios",
    "build:ios:dev": "vite build && npx cap sync ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "build:android": "tsx script/verify-android-release.ts && vite build --mode android && npx cap sync android",
    "build:android:dev": "vite build && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run build:android && tsx script/android-gradle.ts bundleRelease",
    "android:apk": "npm run build:android:dev && tsx script/android-gradle.ts assembleDebug",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc --noEmit && eslint \"client/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\""
  },
