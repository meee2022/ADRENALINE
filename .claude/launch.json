{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adrenaline-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5001,
      "autoPort": true
    },
    {
      "name": "adrenaline-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/mobile",
        "run",
        "web",
        "--",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}
