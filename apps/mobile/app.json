{
  "expo": {
    "name": "Adrenaline",
    "slug": "adrenaline-healthy-food",
    "version": "1.2.0",
    "scheme": "adrenaline",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adrenalinehealthy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.adrenalinehealthy.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2138",
          "image": "./assets/brand-heart-original.png",
          "imageWidth": 148,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3CC4F0",
          "defaultChannel": "orders"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "convexUrl": "https://laudable-mongoose-958.convex.cloud",
      "siteUrl": "https://adrenalinehealthy.com",
      "router": {},
      "eas": {
        "projectId": "d2f443ec-a622-4dd1-a727-62983aaab4ba"
      },
      "subscriberPushEnabled": true
    },
    "owner": "meee87"
  }
}
